import pyspark.sql.functions as F
from pyspark.sql.types import DoubleType
from pyspark.sql.window import Window
import re

STOP_WORDS = ["inc", "llc", "corp", "corporation", "ltd", "limited", "the", "and", "co", "company"]

def optimize_fuzzy_match_pyspark(
    spark, 
    targets_df, 
    universe_df, 
    target_name_col, 
    universe_name_col, 
    account_id_col,
    min_confidence: float = 0.85, 
    top_n: int = None
):
    # 1. Normalize Targets
    targets_clean = (
        targets_df
        .select(F.col(target_name_col).alias("target_name"))
        .where(F.col("target_name").isNotNull())
        .withColumn("target_norm", normalize_name_col(F.col("target_name")))
        .where(F.length("target_norm") > 0)
        .withColumn("target_id", F.monotonically_increasing_id())
    )

    # 2. Normalize Universe
    universe_clean = (
        universe_df
        .select(
            F.col('athena_hq_est_total_spend'),
            F.col(universe_name_col).alias("matched_name"),
            F.col(account_id_col).alias("account_id")
        )
        .where(F.col("matched_name").isNotNull())
        .withColumn("matched_norm", normalize_name_col(F.col("matched_name")))
        .where(F.length("matched_norm") > 0)
    )

    # 3. Strategy A: Regex Substring Blocking
    target_names = [row.target_norm for row in targets_clean.collect()]
    regex_pattern = "|".join([re.escape(name) for name in target_names])
    
    substring_universe = universe_clean.filter(F.col("matched_norm").rlike(regex_pattern))
    
    substring_pairs = (
        targets_clean.alias("t")
        .crossJoin(F.broadcast(substring_universe.alias("u")))
        .filter(
            F.col("u.matched_norm").contains(F.col("t.target_norm")) |
            F.col("t.target_norm").contains(F.col("u.matched_norm"))
        )
        .select(
            F.col("t.target_id"), 
            F.col("u.account_id"),
            F.lit(0).alias("is_acronym")
        )
    )

    # 4. Strategy B: Native Acronym Blocking
    def add_acronym_cols(df, norm_col):
        df = df.withColumn("compact", F.regexp_replace(norm_col, " ", ""))
        df = df.withColumn("words", F.split(norm_col, " "))
        df = df.withColumn("acronym", F.array_join(F.expr("transform(words, x -> substring(x, 1, 1))"), ""))
        return df
        
    t_acr = add_acronym_cols(targets_clean, "target_norm")
    u_acr = add_acronym_cols(universe_clean, "matched_norm")
    
    acronym_pairs = (
        t_acr.alias("t").join(u_acr.alias("u"), 
            (F.col("t.compact") == F.col("u.acronym")) |
            (F.col("t.acronym") == F.col("u.compact"))
        )
        .select(
            F.col("t.target_id"), 
            F.col("u.account_id"),
            F.lit(1).alias("is_acronym")
        )
    )

    # 5. Strategy C: Phonetic Word Blocking
    t_words = (
        targets_clean
        .withColumn("word", F.explode(F.split("target_norm", " ")))
        .filter(~F.col("word").isin(STOP_WORDS))
        .filter(F.length("word") > 2) 
        .withColumn("sound", F.soundex("word"))
    )
    
    u_words = (
        universe_clean
        .withColumn("word", F.explode(F.split("matched_norm", " ")))
        .filter(~F.col("word").isin(STOP_WORDS))
        .filter(F.length("word") > 2)
        .withColumn("sound", F.soundex("word"))
    )
    
    word_pairs = (
        t_words.alias("t")
        .join(u_words.alias("u"), on="sound")
        .select(
            F.col("t.target_id"), 
            F.col("u.account_id"),
            F.lit(0).alias("is_acronym")
        )
    )

    # 6. Combine and Deduplicate
    all_candidate_pairs = (
        substring_pairs
        .unionByName(acronym_pairs)
        .unionByName(word_pairs)
        .groupBy("target_id", "account_id")
        .agg(F.max("is_acronym").alias("is_acronym"))
    )
    
    candidates_to_score = (
        all_candidate_pairs
        .join(targets_clean, on="target_id")
        .join(universe_clean, on="account_id")
    )
    
    # 7. Heavy Scoring with Registered UDFs
    substring_expr = F.when(
        F.col("target_norm").contains(F.col("matched_norm")) |
        F.col("matched_norm").contains(F.col("target_norm")),
        F.lit(1.0)
    ).otherwise(F.lit(0.0))

    scored = (
        candidates_to_score
        .withColumn("jw_score", jw_udf(F.col("target_norm"), F.col("matched_norm")))
        .withColumn("token_score", token_set_udf(F.col("target_norm"), F.col("matched_norm")))
        .withColumn("substring_score", substring_expr)
        .withColumn(
            "dl_score",
            F.when(
                (F.col("jw_score") >= 0.75) | (substring_expr == 1),
                dl_udf(F.col("target_norm"), F.col("matched_norm"))
            ).otherwise(F.lit(0.0))
        )
        .withColumn(
            "blend_score",
            0.55 * F.col("jw_score") +
            0.30 * F.col("token_score") +
            0.10 * F.col("substring_score") +
            0.05 * F.col("dl_score")
        )
        .withColumn(
            "confidence",
            F.round(
                F.when(F.col("target_norm") == F.col("matched_norm"), 1.0)
                .when(
                    F.col("substring_score") == 1,
                    F.greatest(F.col("blend_score"), F.lit(0.88))
                )
                .when(
                    F.col("is_acronym") == 1,
                    F.greatest(F.col("blend_score"), F.lit(0.87))
                )
                .when(
                    (F.col("token_score") >= 0.999) &
                    (F.col("jw_score") >= 0.80),
                    F.greatest(F.col("blend_score"), F.lit(0.90))
                )
                .otherwise(F.col("blend_score")),
                4
            )
        )
        .withColumn(
            "match_type",
            F.when(F.col("target_norm") == F.col("matched_norm"), "exact")
            .when(F.col("substring_score") == 1, "substring")
            .when(F.col("is_acronym") == 1, "acronym")
            .when(F.col("token_score") >= 0.999, "token_subset")
            .otherwise("fuzzy"),
        )
        .filter(F.col("confidence") >= (min_confidence - 0.05))
    )

    # 8. Top N Filter
    if top_n:
        w = Window.partitionBy("target_norm").orderBy(F.desc("confidence"))
        scored = (
            scored
            .withColumn("rank", F.row_number().over(w))
            .where(F.col("rank") <= top_n)
            .drop("rank")
        )

    # 9. Final Output
    result = (
        scored
        .select(
            "athena_hq_est_total_spend",
            "target_name",
            "matched_name",
            "account_id",
            "confidence",
            "match_type",
            "jw_score",
            "token_score",
            "substring_score",
            "dl_score"
        )
        .dropDuplicates(["target_name", "account_id"])
    )

    return result
