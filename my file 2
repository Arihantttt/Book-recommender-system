                    "Jaro-Winkler Suffix Score": 0,
                    "Levenshtein Suffix Score": 0,
                    "Jaccard Suffix Score": 0,
                    "Lookup List_Original Name": lookup_row['List_Original Name'],
                }
            
            # Sort final_suffix_matches in descending order of final scores
            final_suffix_matches.sort(key = lambda x: x[1], reverse = True)

            best_suffix_match, best_suffix_score = final_suffix_matches[0]

            lookup_row = matched_lookup_rows[matched_lookup_rows['List_Secondary Suffix'] == best_suffix_match].iloc[0]

            return {
                "Original Name": original_name,
                "Final Base Name Match": lookup_row['List_Final Base Name'],
                "Jaro-Winkler Base Name Match": jaro_winkler_base_matches[0][0],
                "Levenshtein Base Name Match": levenshtein_base_matches[0][0],
                "Jaccard Base Name Match": jaccard_base_matches[0][0],
                "Final Base Name Score": base_score,
                "Jaro-Winkler Base Name Score": jaro_winkler_base_matches[0][1],
                "Levenshtein Base Name Score": levenshtein_base_matches[0][1],
