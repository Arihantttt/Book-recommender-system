final_score_threshold = 0


def jaccard_similarity(item, choices, scorer = fuzz.token_set_ratio):
    """
    Find all matches for an item from a list of choices using Jaccard similarity.
    
    Apply a stricter rule (no matches with a single character difference) only if the item is a single word.
    """
    # Ensure the item is a string
    if not isinstance(item, str) or pd.isna(item):
        return [] # No matches for non-string or NaN values

    # Check for exact matches first
    if item in choices:
        return [(item, 100)] # Exact match with a perfect score

    matches = process.extract(item, choices, scorer=scorer, limit=None)

    # Check if the original name is a single word
    is_single_word = len(item.split()) == 1

    # Filter matches
    filtered_matches = []

    for match in matches:
        match_name, match_score = match[0], match[1] # Unpack only the first two elements

        # Apply the stricter rule only if the original name is a single word
        if is_single_word and Levenshtein.distance(item, match_name) == 1:
            continue # Skip matches with single character differences
        
        filtered_matches.append((match_name, match_score))

    return filtered_matches




def jaro_winkler_similarity(item, choices):
    """
    Compares a base string with a list of strings using Jaro_Winkler distance similarity.
    Returns a list of tuples (string, similarity_score) for matches above the threshold.
    """

    # Ensure the item is a string and choices is non-empty
    if not isinstance(item, str) or pd.isna(item) or not any(choices):
        return [] # No matches for non-string or NaN values

    # Check for exact matches first
    if item in choices:
        return [(item, 100)] # Exact match with a perfect score

    # Check if the original name is a single word
    is_single_word = len(item.split()) == 1

    matches = []

    for choice in choices:
        # Apply the stricter rule only if the original name is a single word
        if is_single_word and Levenshtein.distance(item, choice) == 1:
            continue # Skip matches with single character differences
        
        score = textdistance.jaro_winkler(item, choice)
        
        matches.append((choice, round(score, 3)*100))
        
    return matches





def levenshtein_similarity(item, choices):
    """
    Compares a base string with a list of strings using Jaro_Winkler distance similarity.
    Returns a list of tuples (string, similarity_score) for matches above the threshold.
    """

    # Ensure the item is a string and choices is non-empty
    if not isinstance(item, str) or pd.isna(item) or not any(choices):
        return [] # No matches for non-string or NaN values

    # Check for exact matches first
    if item in choices:
        return [(item, 100)] # Exact match with a perfect score

    # Check if the original name is a single word
    is_single_word = len(item.split()) == 1

    matches = []

    for choice in choices:
        dist = Levenshtein.distance(item, choice) # Compute Levenshtein distance

        if is_single_word and dist == 1:
            continue
        
        score = 1 - (dist / max(len(item), len(choice)))

        matches.append((choice, round(score, 3) * 100))

    return matches




# Calculate final weighted score: Jaro-Winkler weight: 0.45, Levenshtein weight: 0.15 Jaccard weight: 0.4
def final_score(jaro_winkler_score, levenshtein_score, jaccard_score):
    final_score = 0.45 * jaro_winkler_score + 0.15 * levenshtein_score + 0.4 * jaccard_score
    return final_score





def process_row(row):

    original_name = row['Original Name']

    final_base_name = row['Final Base Name']

    secondary_suffix = row['Secondary Suffix']

    # Get matches for Final Base Name

    jaccard_base_matches = jaccard_similarity(final_base_name, data_lookup['List_Final Base Name'].dropna().unique(), fuzz.token_set_ratio)

    jaro_winkler_base_matches = jaro_winkler_similarity(final_base_name, data_lookup['List_Final Base Name'].dropna().unique())

    levenshtein_base_matches = levenshtein_similarity(final_base_name, data_lookup['List_Final Base Name'].dropna().unique())

    # Sort the base matches for all the 3 algorithms
    jaccard_base_matches.sort(key = lambda x: x[1], reverse = True)
    
    jaro_winkler_base_matches.sort(key = lambda x: x[1], reverse = True)
    
    levenshtein_base_matches.sort(key = lambda x: x[1], reverse = True)

    # Convert these base matches to a dictionary
    jaccard_base_matches_dict = dict(jaccard_base_matches)
    
    jaro_winkler_base_matches_dict = dict(jaro_winkler_base_matches)
    
    levenshtein_base_matches_dict = dict(levenshtein_base_matches)

    # Extract base names from all the 3 algorithms in order to calculate the final score
    
    base_names = jaccard_base_matches_dict.keys() & jaro_winkler_base_matches_dict.keys() & levenshtein_base_matches_dict.keys()
    
    base_matches = [(name, final_score(jaro_winkler_base_matches_dict[name], levenshtein_base_matches_dict[name], jaccard_base_matches_dict[name])) for name in base_names]

    # Keep only those matches whose score is above the final threshold value
    final_base_matches = [item for item in base_matches if item[1] >= final_score_threshold]

    # Check whether final_base_matches is empty or not
    if not final_base_matches:

        return {
            "Original Name": original_name,
            "Final Base Name Match": None,
            "Jaro-Winkler Base Name Match": jaro_winkler_base_matches[0][0],
            "Levenshtein Base Name Match": levenshtein_base_matches[0][0],
            "Jaccard Base Name Match": jaccard_base_matches[0][0],
            "Final Base Name Score": 0,
