            "Jaro-Winkler Suffix Score": 0,
            "Levenshtein Suffix Score": 0,
            "Jaccard Suffix Score": 0,
            "Lookup List_Original Name": None
        }
    
    # Sort final base matches based on score:
    final_base_matches = sorted(final_base_matches, key = lambda x: x[1], reverse = True)

    for base_match, base_score in final_base_matches:

        # Filter lookup table for rows matching the current base match
        matched_lookup_rows = data_lookup[data_lookup['List_Final Base Name'] == base_match]

        # If no Secondary Suffix is provided
        if pd.isna(secondary_suffix) or not secondary_suffix.strip():
            
            lookup_row = matched_lookup_rows.iloc[0]
            
            return {
                "Original Name": original_name,
                "Final Base Name Match": lookup_row['List_Final Base Name'],
                "Jaro-Winkler Base Name Match": jaro_winkler_base_matches[0][0],
                "Levenshtein Base Name Match": levenshtein_base_matches[0][0],
                "Jaccard Base Name Match": jaccard_base_matches[0][0],
