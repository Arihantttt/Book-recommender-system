                "Jaro-Winkler Suffix Match": None,
                "Levenshtein Suffix Match": None,
                "Jaccard Suffix Match": None,
                "Secondary Suffix Score": 0,
                "Jaro-Winkler Suffix Score": 0,
                "Levenshtein Suffix Score": 0,
                "Jaccard Suffix Score": 0,
                "Lookup List_Original Name": lookup_row['List_Original Name']
            }

        # Match Secondary Suffix only within rows that match the selected Final Base Name

        jaccard_suffix_matches = jaccard_similarity(secondary_suffix, matched_lookup_rows['List_Secondary Suffix'].dropna().unique(), fuzz.token_set_ratio)

        jaro_winkler_suffix_matches = jaro_winkler_similarity(secondary_suffix, matched_lookup_rows['List_Secondary Suffix'].dropna().unique())

        levenshtein_suffix_matches = levenshtein_similarity(secondary_suffix, matched_lookup_rows['List_Secondary Suffix'].dropna().unique())

        # Sort suffix matches of all the 3 algorithms
        jaccard_suffix_matches.sort(key = lambda x: x[1], reverse = True)

        jaro_winkler_suffix_matches.sort(key = lambda x: x[1], reverse = True)

        levenshtein_suffix_matches.sort(key = lambda x: x[1], reverse = True)

        # Convert suffix matches to a dictionary
        jaccard_suffix_matches_dict = dict(jaccard_suffix_matches)

        jaro_winkler_suffix_matches_dict = dict(jaro_winkler_suffix_matches)

        levenshtein_suffix_matches_dict = dict(levenshtein_suffix_matches)

        if (jaccard_suffix_matches_dict and jaro_winkler_suffix_matches_dict and levenshtein_suffix_matches_dict):

            # Extract secondary suffix names from all the 3 algorithms in order to calculate the final score

            suffixes = jaccard_suffix_matches_dict.keys() & jaro_winkler_suffix_matches_dict.keys() & levenshtein_suffix_matches_dict.keys()

            suffix_matches = [(suffix, final_score(jaro_winkler_suffix_matches_dict[suffix], levenshtein_suffix_matches_dict[suffix], jaccard_suffix_matches_dict[suffix])) for suffix in suffixes]

            # Keep only those matches whose score is above the final threshold value
            final_suffix_matches = [item for item in suffix_matches if item[1] >= final_score_threshold]

            # Fallback: If no match for final secondary suffix, return Final Base Name match

            if not final_suffix_matches:

                lookup_row = matched_lookup_rows.iloc[0]

                return {
                    "Original Name": original_name,
                    "Final Base Name Match": lookup_row['List_Final Base Name'],
                    "Jaro-Winkler Base Name Match": jaro_winkler_base_matches[0][0],
                    "Levenshtein Base Name Match": levenshtein_base_matches[0][0],
