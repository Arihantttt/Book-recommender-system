def process_in_batches(data, batch_size):

    results = []

    for start in range(0, len(data), batch_size):
        
        batch = data[start:start + batch_size]
        
        with ThreadPoolExecutor(max_workers = 3) as executor: # Adjust the number of threads based on system capacity
            
            batch_results = list(executor.map(process_row, batch))
            
        results.extend(batch_results)

    return results






